---
import { PAGES } from "../lib/pages";
import { localePath, t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** current path without the language prefix, e.g. "/software/aha-tasks" */
  current: string;
}
const { lang, current } = Astro.props;
const isCurrent = (path: string) => current === path || current.startsWith(path + "/");
---

<ul>
  {
    PAGES.map((item) => (
      <li>
        <a href={localePath(lang, item.path)} aria-current={isCurrent(item.path) ? "page" : undefined}>
          {t(lang, item.key)}
        </a>
      </li>
    ))
  }
</ul>
